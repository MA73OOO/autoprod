{
  "dependencies": [
    {
      "id": "python",
      "name": "Python 3.10",
      "description": "El motor principal requerido para ejecutar todos los scripts y procesos pesados.",
      "type": "binary",
      "min_version": "3.10.0",
      "windows_url": "https://www.python.org/ftp/python/3.10.11/python-3.10.11-amd64.exe",
      "mac_url": "https://www.python.org/ftp/python/3.10.11/python-3.10.11-macos11.pkg",
      "install_command_win": "/quiet InstallAllUsers=0 PrependPath=0 Include_test=0 Include_pip=1",
      "install_command_mac": "installer -pkg {FILE} -target CurrentUserHomeDirectory",
      "check_command": "python --version",
      "local_path_win": "python",
      "local_path_mac": "python3"
    },
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "description": "Software esencial para procesar, cortar y unir videos o audios.",
      "type": "binary",
      "min_version": "6.0",
      "windows_url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip",
      "mac_url": "https://evermeet.cx/ffmpeg/ffmpeg-6.0.zip",
      "check_command": "ffmpeg -version",
      "local_path_win": "ffmpeg.exe",
      "local_path_mac": "ffmpeg"
    },
    {
      "id": "yt-dlp",
      "name": "yt-dlp",
      "description": "Herramienta que permite descargar videos, audios y metadatos de YouTube.",
      "type": "binary",
      "min_version": "2023",
      "windows_url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe",
      "mac_url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_macos",
      "check_command": "yt-dlp --version",
      "local_path_win": "yt-dlp.exe",
      "local_path_mac": "yt-dlp"
    },
    {
      "id": "openai-whisper",
      "name": "Whisper (OpenAI)",
      "description": "Inteligencia Artificial para transcribir audios a texto con alta precisión.",
      "type": "pip",
      "min_version": "2023",
      "pip_package": "openai-whisper",
      "check_command": "whisper --help"
    },
    {
      "id": "pillow",
      "name": "Pillow",
      "description": "Librería de Python necesaria para manipular y crear imágenes (ej. miniaturas).",
      "type": "pip",
      "min_version": "10.0.0",
      "pip_package": "Pillow",
      "check_command": "python -c \"import PIL; print(PIL.__version__)\""
    },
    {
      "id": "moviepy",
      "name": "moviepy",
      "description": "Librería de Python para editar, cortar y renderizar video programáticamente.",
      "type": "pip",
      "min_version": "1.0.3",
      "pip_package": "moviepy",
      "check_command": "python -c \"import moviepy; print(moviepy.__version__)\""
    }
  ]
}
